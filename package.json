{
  "name": "@ieasybooks/release",
  "version": "2.1.1",
  "description": "The release tooling ieasybooks apps share: store listings, build numbers, AppGallery publishing and the release workflows' checks.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "ieasybooks-release": "./bin/ieasybooks-release.ts"
  },
  "exports": {
    "./build-number": {
      "types": "./build-number.d.cts",
      "default": "./build-number.cjs"
    }
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "build-number.cjs",
    "build-number.d.cts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ruby": "ruby -Iruby/lib ruby/test/review_replacement_test.rb",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run test && bun run format:check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
